---
const metadata = JSON.parse(import.meta.env.PUBLIC_DOCS_BUILD);
const ru = Astro.locals.starlightRoute.lang === 'ru';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<manual-versions data-base={base} data-locale={ru ? 'ru' : 'en'}>
  <label>
    {ru ? 'Версия' : 'Version'}
    <select disabled aria-label={ru ? 'Версия руководства' : 'Manual version'}>
      <option>{metadata.target} {metadata.channel}</option>
    </select>
  </label>
</manual-versions>
<script>
  import { chapterDestination, validBuild } from '../lib/version-routing.mjs';
  class ManualVersions extends HTMLElement {
    async connectedCallback() {
      const select = this.querySelector('select')!;
      const base = this.dataset.base!;
      const locale = this.dataset.locale!;
      const chapter = decodeURI(location.pathname).slice(`${base}${locale}/`.length).replace(/\/$/, '');
      try {
        const response = await fetch(`${base}versions.json`);
        if (!response.ok) return;
        const builds = await response.json();
        if (!Array.isArray(builds) || !builds.every(validBuild) || !builds.some(b => b.base === base)) return;
        if (new Set(builds.map(b => b.base)).size !== builds.length) return;
        const options = builds.map(build => {
          const destination = chapterDestination(build, locale, chapter);
          const fallback = destination.preserved ? '' : locale === 'ru' ? ' (оглавление)' : ' (contents)';
          const option = new Option(`${build.target} ${build.channel}${fallback}`, destination.href);
          option.selected = build.base === base;
          return option;
        });
        select.replaceChildren(...options);
        select.disabled = builds.length < 2;
        select.onchange = () => location.assign(select.value);
      } catch { /* Keep the current build visible when the registry is unavailable. */ }
    }
  }
  customElements.define('manual-versions', ManualVersions);
</script>
<style>
  label { display: inline-flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
  select { font: inherit; max-width: 100%; padding: .35rem; color: inherit; background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-4); border-radius: 4px; }
</style>
